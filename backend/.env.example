PORT=8787
RPC_URL=https://bsc-dataseed.binance.org
CHAIN_ID=56
CONTRACT_ADDRESS=0xYourDeployedProxy
FROM_BLOCK=0

# Contract owner key — this is the ONLY wallet that can pull / set limits.
# Keep it on the server, never expose it to the browser.
OWNER_PRIVATE_KEY=0x...

# Wallet addresses allowed to log into the admin dashboard (comma separated).
ADMIN_ADDRESSES=0xAdminWallet1,0xAdminWallet2

JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=http://localhost:5173
ADMIN_PASSWORD=change-me
